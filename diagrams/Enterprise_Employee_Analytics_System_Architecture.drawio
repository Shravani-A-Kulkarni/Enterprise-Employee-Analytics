        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\nsubgraph USERS[\&quot;USERS\&quot;]\n    direction TB\n    USER[\&quot;USER&lt;br/&gt;&lt;br/&gt;HR / Executive\&quot;]\nend\n\nsubgraph APPLICATION[\&quot;APPLICATION &amp; PRESENTATION\&quot;]\n    direction TB\n    STREAMLIT[\&quot;STREAMLIT APPLICATION&lt;br/&gt;&lt;br/&gt;Interactive UI&lt;br/&gt;Pages 1–4\&quot;]\n    DASH[\&quot;ANALYTICS DASHBOARD&lt;br/&gt;&lt;br/&gt;KPIs • Charts&lt;br/&gt;Employee Insights\&quot;]\nend\n\nUSER --&gt; STREAMLIT\nSTREAMLIT --&gt; DASH\n\nsubgraph ANALYTICS[\&quot;ANALYTICS &amp; QUERY\&quot;]\n    direction TB\n    SQL[\&quot;ANALYTICS SQL&lt;br/&gt;&lt;br/&gt;CTEs&lt;br/&gt;Window Functions&lt;br/&gt;&lt;br/&gt;LAG() • RANK() • DENSE_RANK()\&quot;]\nend\n\nDASH --&gt;|\&quot;Queries\&quot;| SQL\nSQL --&gt;|\&quot;Results\&quot;| DASH\n\nsubgraph DATAWAREHOUSE[\&quot;OLAP DATA WAREHOUSE\&quot;]\n    direction TB\n    OLAP[\&quot;OLAP DATA WAREHOUSE&lt;br/&gt;&lt;br/&gt;Star Schema&lt;br/&gt;&lt;br/&gt;Dim_Employee&lt;br/&gt;Dim_Project&lt;br/&gt;Dim_Date&lt;br/&gt;Dim_Department&lt;br/&gt;Fact_PerformanceReviews\&quot;]\nend\n\nSQL --&gt;|\&quot;Query\&quot;| OLAP\n\nsubgraph ETL_LAYER[\&quot;ETL PIPELINE\&quot;]\n    direction TB\n    ETL[\&quot;ETL PIPELINE&lt;br/&gt;&lt;br/&gt;Extract → Clean →&lt;br/&gt;Transform → Load&lt;br/&gt;&lt;br/&gt;Python + Pandas\&quot;]\n    SCD[\&quot;SCD TYPE 2&lt;br/&gt;&lt;br/&gt;Historical Employee Changes&lt;br/&gt;Start Date • End Date • Is Current\&quot;]\nend\n\nETL --&gt; SCD\nSCD --&gt;|\&quot;Load\&quot;| OLAP\n\nsubgraph OLTP_LAYER[\&quot;OLTP DATABASE\&quot;]\n    direction TB\n    OLTP[\&quot;OLTP MYSQL&lt;br/&gt;&lt;br/&gt;Operational Database&lt;br/&gt;&lt;br/&gt;Employees&lt;br/&gt;Departments&lt;br/&gt;Projects&lt;br/&gt;Assignments&lt;br/&gt;Reviews\&quot;]\nend\n\nOLTP --&gt;|\&quot;Extract\&quot;| ETL\n\nsubgraph PYTHON_LAYER[\&quot;PYTHON APPLICATION\&quot;]\n    direction TB\n    PYTHON[\&quot;PYTHON APPLICATION&lt;br/&gt;&lt;br/&gt;Application Logic&lt;br/&gt;Database Connections\&quot;]\n    DB[\&quot;MySQL Database Access\&quot;]\n    PYTHON --&gt; DB\nend\n\nDB --&gt;|\&quot;Operational Data Access\&quot;| OLTP\n\nsubgraph CLOUD_DB[\&quot;CLOUD DATABASE HOSTING\&quot;]\n    direction TB\n    AIVEN[\&quot;AIVEN CLOUD&lt;br/&gt;&lt;br/&gt;Managed MySQL&lt;br/&gt;SSL Connection\&quot;]\nend\n\nAIVEN -.-&gt;|\&quot;Hosts\&quot;| OLTP\nAIVEN -.-&gt;|\&quot;Hosts\&quot;| OLAP\n\nsubgraph VERSION[\&quot;VERSION CONTROL &amp; DEPLOYMENT\&quot;]\n    direction TB\n    GITHUB[\&quot;GITHUB&lt;br/&gt;&lt;br/&gt;Source Code + Repository\&quot;]\n    CLOUD[\&quot;STREAMLIT COMMUNITY CLOUD&lt;br/&gt;&lt;br/&gt;Application Deployment\&quot;]\n    GITHUB --&gt;|\&quot;Deploy\&quot;| CLOUD\nend\n\nCLOUD -.-&gt;|\&quot;Runs\&quot;| STREAMLIT\n\nclassDef userStyle fill:#1F2937,stroke:#94A3B8,stroke-width:2px,color:#FFFFFF;\nclassDef appStyle fill:#173B4D,stroke:#3B82F6,stroke-width:2px,color:#FFFFFF;\nclassDef analyticsStyle fill:#173B4D,stroke:#60A5FA,stroke-width:2px,color:#FFFFFF;\nclassDef databaseStyle fill:#202333,stroke:#818CF8,stroke-width:2px,color:#FFFFFF;\nclassDef etlStyle fill:#173B4D,stroke:#38BDF8,stroke-width:2px,color:#FFFFFF;\nclassDef pythonStyle fill:#173B4D,stroke:#60A5FA,stroke-width:2px,color:#FFFFFF;\nclassDef cloudStyle fill:#3B263F,stroke:#D98BE8,stroke-width:2px,color:#FFFFFF;\nclassDef versionStyle fill:#3B2A0A,stroke:#F59E0B,stroke-width:2px,color:#FFFFFF;\n\nclass USER userStyle;\nclass STREAMLIT,DASH appStyle;\nclass SQL analyticsStyle;\nclass OLAP,OLTP databaseStyle;\nclass ETL,SCD etlStyle;\nclass PYTHON,DB pythonStyle;\nclass AIVEN cloudStyle;\nclass GITHUB,CLOUD versionStyle;\n\nstyle USERS fill:#111827,stroke:#64748B,stroke-width:1px,color:#FFFFFF\nstyle APPLICATION fill:#0F2938,stroke:#2563EB,stroke-width:2px,color:#FFFFFF\nstyle ANALYTICS fill:#0F2938,stroke:#2563EB,stroke-width:2px,color:#FFFFFF\nstyle DATAWAREHOUSE fill:#171827,stroke:#6366F1,stroke-width:2px,color:#FFFFFF\nstyle ETL_LAYER fill:#0F2938,stroke:#0EA5E9,stroke-width:2px,color:#FFFFFF\nstyle OLTP_LAYER fill:#171827,stroke:#6366F1,stroke-width:2px,color:#FFFFFF\nstyle PYTHON_LAYER fill:#0F2938,stroke:#2563EB,stroke-width:2px,color:#FFFFFF\nstyle CLOUD_DB fill:#321E38,stroke:#D946EF,stroke-width:2px,color:#FFFFFF\nstyle VERSION fill:#33230A,stroke:#F59E0B,stroke-width:2px,color:#FFFFFF&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="UOZtGvg8ebnkjc9LGfAb-1">
